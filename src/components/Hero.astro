---
import { profile, profileText } from "../data/profile";
import { type Lang, useTranslations } from "../i18n";
import Lanyard from "./lanyard/Lanyard";
import type { BadgeInfo } from "./lanyard/badgeTexture";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = profileText(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const badge: BadgeInfo = {
  name: profile.fullName,
  handle: profile.name.toLowerCase(),
  role: p.title,
  location: "Asunción, Paraguay",
  status: t("hero.badgeStatus"),
  photo: `${base}/${profile.photo}`,
  id: "#61221866",
  site: Astro.site ? new URL(Astro.site).host : "",
  back: ["> whoami", "guillermo alvarez", "full-stack · cto · game dev", "> stack", "react-native · go · node · unity", "> lived_in", "asunción · genève · la granja", "> awards", "moonshot '25 · innovandopy '25", "> status", "sipping tereré"],
  access: "ACCESS: ROOT",
};
---

<section id="top" class="relative overflow-hidden pt-24 pb-12 sm:pt-28 lg:min-h-[100svh] lg:pb-16">
  <canvas data-dotgrid aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full [mask-image:radial-gradient(ellipse_at_top,black_35%,transparent_80%)]"></canvas>
  <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[780px] -translate-x-1/2 rounded-full bg-accent/15 blur-[120px]"></div>

  <!-- Cinematic HUD -->
  <div class="pointer-events-none absolute inset-x-3 top-20 bottom-3 hidden sm:block" aria-hidden="true">
    <span class="hud-corner top-0 left-0 border-t-2 border-l-2"></span>
    <span class="hud-corner top-0 right-0 border-t-2 border-r-2"></span>
    <span class="hud-corner bottom-0 left-0 border-b-2 border-l-2"></span>
    <span class="hud-corner right-0 bottom-0 border-r-2 border-b-2"></span>
    <p class="absolute top-3 left-8 font-mono text-[10px] tracking-widest text-slate-500">
      <span class="animate-pulse text-red-500">●</span> REC · SC.00 · TAKE 01
    </p>
    <p class="absolute top-3 right-8 font-mono text-[10px] tracking-widest text-slate-500">25.2637°S 57.5759°W</p>
    <p class="absolute bottom-3 left-8 font-mono text-[10px] tracking-widest text-slate-500">ISO 800 · 24 FPS · 2.39:1</p>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-6 px-4 sm:px-6 lg:min-h-[calc(100svh-10rem)] lg:grid-cols-[1.15fr_1fr]">
    <!-- On desktop the badge canvas fills the hero behind this column; empty space lets the pointer through to it. -->
    <div class="relative z-10 pt-6 lg:pointer-events-none lg:pt-0 lg:*:pointer-events-auto">
      {
        profile.available && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-xs text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent" />
            </span>
            {t("hero.available")}
          </p>
        )
      }
      <p class="font-mono text-sm text-slate-400">{t("hero.hi")}</p>
      <h1 class="mt-2 font-display text-5xl leading-[0.95] font-bold tracking-tight text-white sm:text-7xl xl:text-8xl">
        <span data-scramble class="after:text-accent after:content-['.']">{profile.fullName}</span>
      </h1>
      <p class="mt-3 font-mono text-sm text-slate-400">
        aka <span class="text-accent">@{profile.name.toLowerCase()}</span> · 🇵🇾 Asunción, Paraguay
      </p>
      <p class="mt-4 h-9 font-display text-2xl font-medium whitespace-nowrap sm:h-10 sm:text-3xl">
        <span class="text-slate-500">&gt;</span> <span class="inline-block text-gradient" data-rotate={JSON.stringify(p.roles)}>{p.roles[0]}</span><span class="ml-1 inline-block h-6 w-2.5 translate-y-0.5 animate-pulse bg-accent sm:h-7"></span>
      </p>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
        {t("hero.intro")}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#about" data-magnet class="shine rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-ink-950 transition hover:brightness-110">
          {t("hero.cta.about")}
        </a>
        <a href="#journey" data-magnet class="rounded-xl border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/5">
          🌎 {t("hero.cta.journey")}
        </a>
      </div>
    </div>

    <Lanyard client:visible info={badge} hint={t("hero.badgeHint")} />
  </div>
</section>
