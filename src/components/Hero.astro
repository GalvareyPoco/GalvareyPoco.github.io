---
import { profile, profileText } from "../data/profile";
import { type Lang, useTranslations } from "../i18n";
import Terminal from "./Terminal";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = profileText(lang);
---

<section id="top" class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"></div>
  <div class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[780px] -translate-x-1/2 rounded-full bg-accent/15 blur-[120px]"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.1fr_1fr]">
    <div>
      {
        profile.available && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-xs text-accent">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent" />
            </span>
            {t("hero.available")}
          </p>
        )
      }
      <p class="font-mono text-sm text-slate-400">{t("hero.hi")}</p>
      <h1 class="mt-2 font-display text-5xl font-bold tracking-tight text-white sm:text-7xl">
        {profile.name}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 font-display text-2xl font-medium text-gradient sm:text-3xl">{p.title}</p>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
        {t("hero.intro")}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class="rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-emerald-300">
          {t("hero.cta.work")}
        </a>
        <a href="#contact" class="rounded-xl border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/5">
          {t("hero.cta.contact")}
        </a>
      </div>
      <p class="mt-8 font-mono text-xs text-slate-500">📍 {p.location}</p>
    </div>

    <Terminal client:visible lang={lang} label={t("hero.terminalLabel")} />
  </div>
</section>
