---
import { profile, profileText } from "../data/profile";
import { type Lang, useTranslations } from "../i18n";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = profileText(lang);
const last = profile.ventures.length - 1;
---

<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
  <SectionHeading index="01" kicker={t("about.kicker")} title={t("about.title")} />
  <dl class="reveal mb-12 grid gap-4 sm:grid-cols-3">
    {
      p.highlights.map((h) => (
        <div class="spotlight card p-5">
          <dt class="sr-only">{h.label}</dt>
          <dd class="font-display text-4xl font-bold text-gradient">{h.value}</dd>
          <dd class="mt-1 text-sm text-slate-400">{h.label}</dd>
        </div>
      ))
    }
  </dl>
  <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
    <div class="reveal space-y-5 text-lg leading-relaxed text-slate-400">
      {p.about.map((para) => <p>{para}</p>)}
      <p class="pt-2 text-base">
        {t("about.wizard")}{" "}
        {
          profile.ventures.map((v, i) => (
            <>
              <a href={v.url} target="_blank" rel="noopener" class="font-medium text-white underline decoration-accent/50 underline-offset-4 hover:decoration-accent">
                {v.label}
              </a>
              {i < last - 1 ? ", " : i === last - 1 ? ` ${t("about.and")} ` : "."}
            </>
          ))
        }
      </p>
    </div>

    <div class="reveal space-y-6">
      <div class="spotlight card p-5">
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">{t("about.focus")}</p>
        <ul class="flex flex-wrap gap-2">
          {p.focus.map((f) => <li class="rounded-lg bg-accent/10 px-2.5 py-1 text-sm text-accent">{f}</li>)}
        </ul>
      </div>
      <div class="spotlight card p-5">
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">{t("about.languages")}</p>
        <ul class="space-y-1.5 text-sm text-slate-300">
          {p.languages.map((l) => <li><span class="text-accent-2">▹</span> {l}</li>)}
        </ul>
      </div>
      <div class="spotlight card p-5">
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">{t("about.learning")}</p>
        <ul class="space-y-1.5 text-sm text-slate-300">
          {p.learning.map((l) => <li><span class="text-accent-2">▹</span> {l}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
