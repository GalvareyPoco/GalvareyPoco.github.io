---
import { profile } from "../data/profile";
import { type Lang, langs, languages, homePath, useTranslations } from "../i18n";
import CommandPalette from "./CommandPalette";
import { EGGS, eggStrings } from "../lib/eggs/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  // `n` matches each section's scene number.
  { n: "01", href: "#about", label: t("nav.about") },
  { n: "02", href: "#journey", label: t("nav.journey") },
  { n: "03", href: "#awards", label: t("nav.awards") },
  { n: "04", href: "#experience", label: t("nav.experience") },
  { n: "05", href: "#projects", label: t("nav.projects") },
  { n: "07", href: "#console", label: t("nav.console") },
  { n: "08", href: "#contact", label: t("nav.contact") },
];
const eggs = eggStrings(lang);
const paletteEggs = EGGS.map((id) => ({ id, label: eggs.names[id] }));
const paletteLabels = {
  placeholder: t("palette.placeholder"),
  go: t("palette.go"),
  theme: t("palette.theme"),
  lang: t("palette.lang"),
  actions: t("palette.actions"),
  replay: t("palette.replay"),
  eggs: eggs.group,
  drop: t("palette.drop"),
  copy: t("palette.copy"),
  copied: t("palette.copied"),
  empty: t("palette.empty"),
  hint: t("palette.hint"),
  title: t("nav.palette"),
};
const paletteSections = [
  ...links.slice(0, 5).map((l) => ({ id: l.href.slice(1), label: l.label, n: l.n })),
  { id: "skills", label: t("skills.title"), n: "06" },
  ...links.slice(5).map((l) => ({ id: l.href.slice(1), label: l.label, n: l.n })),
];
const paletteLangs = langs.map((l) => ({ code: l, label: languages[l], href: homePath(l), current: l === lang }));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-ink-950/70 backdrop-blur-md">
  <div id="scroll-progress" class="absolute inset-x-0 bottom-[-1px] h-px origin-left scale-x-0 bg-gradient-to-r from-accent to-accent-2"></div>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href="#top" class="font-mono text-sm font-semibold text-white">
      <span class="text-accent">~/</span>{profile.handle.toLowerCase()}<span class="animate-pulse text-accent">_</span>
    </a>
    <ul class="hidden items-center xl:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="rounded-lg px-2 py-2 text-sm whitespace-nowrap text-slate-400 transition hover:bg-white/5 hover:text-white">
              <span class="font-mono text-xs text-accent">{l.n}.</span> {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
    <button type="button" onclick="window.dispatchEvent(new Event('palette:open'))" title={t("nav.palette")} aria-label={t("nav.palette")} class="flex items-center gap-1 rounded-lg border border-white/10 px-2 py-1 font-mono text-xs text-slate-400 transition hover:border-accent/50 hover:text-white">
      ⌘K
    </button>
    <button type="button" data-theme-toggle title={t("nav.theme")} aria-label={t("nav.theme")} class="flex items-center gap-1.5 rounded-lg border border-white/10 px-2 py-1 font-mono text-xs text-slate-400 transition hover:text-white">
      <span class="h-2.5 w-2.5 rounded-full bg-gradient-to-br from-accent to-accent-2"></span>
      <span data-theme-name class="hidden sm:inline">terere</span>
    </button>
    <ul class="flex items-center rounded-lg border border-white/10 p-0.5 font-mono text-xs" aria-label={t("nav.language")}>
      {
        langs.map((l) => (
          <li>
            <a
              href={homePath(l)}
              hreflang={l}
              lang={l}
              title={languages[l]}
              aria-current={l === lang ? "page" : undefined}
              class:list={[
                "block rounded-md px-2 py-1 uppercase transition",
                l === lang ? "bg-accent text-ink-950" : "text-slate-400 hover:text-white",
              ]}
            >
              {l}
            </a>
          </li>
        ))
      }
    </ul>
    </div>
  </nav>
</header>
<CommandPalette client:idle labels={paletteLabels} sections={paletteSections} languages={paletteLangs} links={[...profile.socials]} eggs={paletteEggs} />
