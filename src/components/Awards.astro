---
import { awardsFor } from "../data/awards";
import { type Lang, useTranslations } from "../i18n";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const awards = awardsFor(lang);
---

<section id="awards" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
  <SectionHeading index="02" kicker={t("awards.kicker")} title={t("awards.title")} />
  <div class="grid gap-5 md:grid-cols-2">
    {
      awards.map((a, i) => (
        <article class="reveal spotlight group card overflow-hidden p-7" style={`transition-delay:${i * 120}ms`}>
          <div class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-accent/10 blur-3xl transition group-hover:bg-accent/20" />
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-xs tracking-widest text-accent uppercase">
                {a.place} · {a.year}
              </p>
              <h3 class="mt-2 font-display text-3xl font-bold text-white sm:text-4xl">{a.name}</h3>
              <p class="mt-1 font-mono text-xs text-slate-500">{a.org}</p>
            </div>
            <span class="text-5xl drop-shadow-[0_0_18px_rgba(251,191,36,0.45)] transition duration-500 group-hover:-rotate-12 group-hover:scale-110" aria-hidden="true">
              🏆
            </span>
          </div>
          <p class="mt-6 font-display text-4xl font-bold text-gradient sm:text-5xl">{a.prize}</p>
          <p class="mt-4 text-slate-400">{a.detail}</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-white/5 pt-4 text-sm">
            <span class="text-slate-500">
              {t("awards.with")}{" "}
              <a href={a.projectUrl} target="_blank" rel="noopener" class="font-medium text-white hover:text-accent">
                {a.project}
              </a>{" "}
              · {t("awards.role")}
            </span>
            <a href={a.source.url} target="_blank" rel="noopener" class="ml-auto font-mono text-xs text-slate-400 hover:text-accent">
              {t("awards.source")}: {a.source.label} ↗
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
