---
import { profile } from "../data/profile";
import { GUAMPA_SVG } from "../lib/guampa";
import { type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="relative scroll-mt-20 overflow-hidden px-4 py-28 sm:px-6">
  <div class="pointer-events-none absolute bottom-0 left-1/2 h-[360px] w-[700px] -translate-x-1/2 rounded-full bg-accent-2/10 blur-[120px]"></div>
  <div class="reveal relative mx-auto max-w-2xl text-center">
    <div class="circ group relative mx-auto mb-8 h-32 w-32" data-cursor data-dodge aria-hidden="true">
      <svg viewBox="0 0 100 100" class="circ-ring h-full w-full text-slate-400 transition-colors group-hover:text-accent">
        <defs><path id="circ-path" d="M50 50 m-38 0 a38 38 0 1 1 76 0 a38 38 0 1 1 -76 0"></path></defs>
        <text font-family="JetBrains Mono, monospace" font-size="8" font-weight="600" fill="currentColor"><textPath href="#circ-path" textLength="236" lengthAdjust="spacingAndGlyphs">{t("contact.circle")}</textPath></text>
      </svg>
      <span class="circ-mate absolute inset-0 grid place-items-center text-5xl" set:html={GUAMPA_SVG} />
    </div>
    <p class="font-mono text-sm text-accent"><span class="rounded border border-white/15 px-1.5 py-0.5 text-[11px] tracking-widest text-slate-400">SC.08</span> {t("contact.kicker")}</p>
    <h2 class="glitch mt-3 font-display text-4xl font-bold tracking-tight text-white sm:text-6xl" data-cursor>{t("contact.title")}</h2>
    <p class="mt-5 text-lg text-slate-400">
      {t("contact.body")}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={profile.socials[1].url} target="_blank" rel="noopener" data-magnet class="shine rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-ink-950 transition hover:brightness-110">
        {t("contact.linkedin")}
      </a>
      {
        profile.email && (
          <a href={`mailto:${profile.email}`} class="rounded-xl border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5">
            {t("contact.email")}
          </a>
        )
      }
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 font-mono text-sm">
      {
        profile.socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="text-slate-400 transition hover:text-accent">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="border-t border-white/5 py-8 text-center font-mono text-xs text-slate-600">
  {t("footer.built")} · © {new Date().getFullYear()} {profile.fullName} · <button type="button" data-dodge="40" class="hover:text-accent" onclick="window.dispatchEvent(new Event('terere:replay'))">{t("footer.terere")} <Fragment set:html={GUAMPA_SVG} /></button>
</footer>
