---
import "../styles/global.css";
import { profile, profileText } from "../data/profile";
import { type Lang, langs, defaultLang, homePath, useTranslations } from "../i18n";
import TerereIntro, { INTRO_KEY } from "../components/TerereIntro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = `${profile.fullName} (${profile.name}) · ${profileText(lang).title}`;
const description = t("meta.description");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale = { en: "en_US", es: "es_PY", fr: "fr_FR" }[lang];
const introLabels = {
  kicker: t("intro.kicker"),
  title: t("intro.title"),
  body: t("intro.body"),
  pour: t("intro.pour"),
  drinkTitle: t("intro.drinkTitle"),
  drink: t("intro.drink"),
  done: t("intro.done"),
  skip: t("intro.skip"),
  keys: t("intro.keys"),
  hint: t("intro.hint"),
  crushTitle: t("intro.crushTitle"),
  crushBody: t("intro.crushBody"),
  crush: t("intro.crush"),
  rondaTitle: t("intro.rondaTitle"),
  rondaBody: t("intro.rondaBody"),
  again: t("intro.again"),
  thanks: t("intro.thanks"),
  sound: t("intro.sound"),
  hintCrush: t("intro.hintCrush"),
  hintDrink: t("intro.hintDrink"),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Before paint: restore the saved theme, and flag first visits so the terere intro shows without a flash. -->
    <script is:inline define:vars={{ INTRO_KEY }}>
      try {
        const theme = localStorage.getItem("theme");
        if (theme && theme !== "matrix") document.documentElement.dataset.theme = theme;
        if (!localStorage.getItem(INTRO_KEY) && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.setAttribute("data-intro", "");
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(homePath(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLang), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#07090f" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={profile.avatar} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@GalvareyPoco" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TerereIntro client:load labels={introLabels} />
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <script>
      import { initEffects } from "../lib/effects";
      initEffects();
    </script>
  </body>
</html>
